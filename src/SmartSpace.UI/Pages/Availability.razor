@page "/beschikbaarheid"

<PageTitle>Beschikbaarheid | SmartSpace</PageTitle>

<section class="page-heading" aria-labelledby="availability-title">
    <p class="eyebrow">Medewerker</p>
    <h1 id="availability-title">Beschikbaarheid</h1>
    <p>Zoek straks een vergaderruimte op tijd, locatie en capaciteit.</p>
</section>

<section class="empty-state" aria-labelledby="availability-status">
    <span class="status-badge">Volgende bouwfase</span>
    <h2 id="availability-status">Zoeken en boeken worden hier toegevoegd</h2>
    <p>De applicatieshell staat klaar. De beschikbaarheidsflow volgt in de user-storyfase.</p>
</section>
